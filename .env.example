# Copy to .env (`make up` does this for you).

# Port the app is published on for the host.
HTTP_PORT=8080

# Address the app listens on.
API_ADDR=:8080

# The bot token from BotFather.
TG_TOKEN=

# The public URL Telegram sends webhook calls to.
PUBLIC_HTTP_HOST=

# --- llm providers ---------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OLLAMA_HOST=http://host.docker.internal:11434

# The local models to register, comma separated. An empty list leaves ollama out.
OLLAMA_MODELS=

# --- postgres ----------------------------------------------------------
POSTGRES_USER=yaa
POSTGRES_PASSWORD=yaa
POSTGRES_DB=yaa

# Port Postgres is published on for the host.
POSTGRES_PORT=5433
