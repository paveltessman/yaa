# Copy to .env (`make up` does this for you).

# Port the app is published on for the host.
HTTP_PORT=8080

# Address the app listens on.
API_ADDR=:8080

# The bot token from BotFather.
TG_TOKEN=

# The public URL Telegram sends webhook calls to.
PUBLIC_HTTP_HOST=

# --- postgres ----------------------------------------------------------
POSTGRES_USER=yaa
POSTGRES_PASSWORD=yaa
POSTGRES_DB=yaa

# Port Postgres is published on for the host.
POSTGRES_PORT=5433
